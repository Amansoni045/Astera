# Astera Backend Environment Variables (Railway / Local)

# Search API Key (Required for web search)
TAVILY_API_KEY=tvly-your-tavily-api-key

# LLM Provider API Keys (Fill at least one; priority order: Groq -> Cerebras -> Gemini -> Mistral -> OpenRouter)
GROQ_API_KEY=gsk_your_groq_api_key
CEREBRAS_API_KEY=csk-your-cerebras-api-key
GEMINI_API_KEY=your-gemini-api-key
MISTRAL_API_KEY=your-mistral-api-key
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key

# Optional CORS allowed origins for production (comma-separated extra origins)
ALLOWED_ORIGINS=https://astera.vercel.app,https://your-custom-domain.com
